#!/bin/bash
# MODÈLE — copie ce fichier en "run-rappels.sh" et renseigne la clé.
# Le vrai fichier (avec la clé) n'est PAS versionné (cf. .gitignore).

BASE_URL="https://tm-rapport-services.vercel.app"
SHARE_LINK_KEY="REMPLACER_PAR_VOTRE_CLE"
# Nom de la LISTE Rappels à remplir — pas une section : l'app Rappels sait
# découper une liste en sections, mais aucune API d'Apple ne les expose.
# Si la liste n'existe pas, l'agent la crée.
LISTE="Signalements"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Verrou atomique : un seul passage à la fois.
LOCKDIR="/tmp/tm-rappels.lock.d"
if ! mkdir "$LOCKDIR" 2>/dev/null; then
  echo "[$(date '+%H:%M:%S')] déjà en cours, on saute."
  exit 0
fi
trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT

echo "[$(date '+%Y-%m-%d %H:%M:%S')] synchro des signalements…"
# Basse priorité CPU + QoS « background » : l'agent cède le pas à l'usage.
nice -n 5 /usr/sbin/taskpolicy -b /usr/bin/osascript -l JavaScript \
  "$SCRIPT_DIR/tm-rappels-signalements.js" "$BASE_URL" "$SHARE_LINK_KEY" "$LISTE"
